# ========================================================
# .gitignore - Nexus Multi-Agente CTT-FISEI UTA
# ========================================================

# Dependencias de Node
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Entorno y Secretos (Seguridad Crítica)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
frontend/.env.local
*.env
!*.env.example

# Compilación y builds
dist/
build/
backend/dist/
frontend/.next/
frontend/out/
.next/
out/

# Logs del sistema y túneles
*.log
tunnel-backend.log
tunnel-frontend.log
logs/
*.pid
*.seed

# Base de datos y volúmenes Docker
postgres_data/
*.sqlite
*.sqlite3

# Archivos del sistema y editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# TypeScript / Prisma generated artifacts temporales
*.tsbuildinfo
